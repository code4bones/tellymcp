{
  "manifest_version": 2,
  "name": "TellyMCP Attach",
  "version": "0.0.3",
  "description": "Attach TellyMCP to an already running browser session.",
  "icons": {
    "32": "icon.svg"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "cookies",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "TellyMCP Attach",
    "default_icon": "icon.svg",
    "default_popup": "popup.html",
    "browser_style": true
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": true
  },
  "web_accessible_resources": [
    "recorder-page.js"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tellymcp-firefox-attach@deadragdoll"
    }
  }
}
